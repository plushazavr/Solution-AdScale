@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title C4 Container Diagram — AdScale (To-Be)

' ===== Акторы =====
Person(advertiser, "Рекламодатель", "Управляет кампаниями и бюджетами")
Person_Ext(endUser, "Пользователь", "Смотрит рекламу и кликает")
System_Ext(dspPartner, "DSP-партнёр", "Присылает bid-requests по OpenRTB")
System_Ext(paymentGateway, "Платёжный шлюз", "Пополнение бюджета")

' ===== Gateway =====
Container(B2BGateway, "B2B Gateway", "API Gateway", "Принимает запросы от DSP")
Container(B2CGateway, "B2C Gateway", "API Gateway", "Принимает запросы от пользователей")
Container(DashboardGateway, "Dashboard Gateway", "API Gateway", "Принимает запросы от кабинета")

' ===== Сервисы =====
Container(biddingService, "Bidding Service", "C++", "Проводит аукцион и выбирает победителя")
Container(deliveryService, "Delivery Service", "Node.js", "Показывает баннер пользователю")
Container(adCabinet, "Advertiser Dashboard", "Node.js", "Личный кабинет рекламодателя")
Container(campaignService, "Campaign Service", "Go", "Создание и редактирование кампаний")
Container(paymentService, "Payment Service", "Go", "Пополнение баланса")
Container(statsService, "Statistics Service", "Python", "Сохраняет клики и показы")
Container(financialService, "Financial Service", "Go", "Списание средств и балансы")
Container(analyticsService, "Analytics Service", "Python", "Готовит отчёты")

' ===== Redis =====
Boundary(redis, "Redis") {
  Container(campaignCache, "Кеш кампаний")
  Container(winnerCache, "Кеш победителей")
  Container(balanceCache, "Кеш балансов")
}

' ===== Kafka =====
Boundary(kafka, "Kafka") {
  Container(clickTopic, "Топик кликов/показов")
  Container(campaignTopic, "Топик кампаний")
  Container(paymentTopic, "Топик платежей")
  Container(balanceTopic, "Топик балансов")
  Container(reqReportTopic, "Топик заказов отчётов")
  Container(respReportTopic, "Топик готовности отчётов")
}

' ===== БД =====
ContainerDb(campaignDb, "БД Кампании", "PostgreSQL", "Данные кампаний")
ContainerDb(financeDb, "БД Финансы", "PostgreSQL", "Данные финансов")
ContainerDb(eventsDb, "БД События", "ClickHouse", "Клики и показы")

' ===== Внешние связи =====
Rel(dspPartner, B2BGateway, "Bid-requests", "HTTPS")
Rel(endUser, B2CGateway, "Показ и клики", "HTTPS")
Rel(advertiser, DashboardGateway, "Работа в кабинете", "HTTPS")
Rel(paymentService, paymentGateway, "Пополнение бюджета", "HTTPS")

' ===== Gateway → сервисы =====
Rel(B2BGateway, biddingService, "Bid-requests", "gRPC")
Rel(B2CGateway, deliveryService, "Запрос баннера", "gRPC")
Rel(DashboardGateway, adCabinet, "Запросы кабинета", "HTTPS")

' ===== Кабинет =====
Rel(adCabinet, campaignService, "Управление кампаниями")
Rel(adCabinet, paymentService, "Пополнение баланса")

' ===== Bidding и Delivery с кешем =====
Rel(biddingService, campaignCache, "Читает кампании")
Rel(biddingService, balanceCache, "Проверяет баланс")
Rel(biddingService, winnerCache, "Пишет победителя")
Rel(deliveryService, winnerCache, "Читает победителя")
Rel(deliveryService, campaignCache, "Читает баннер")

' ===== Сервисы обновляют кеш =====
Rel(campaignService, campaignCache, "Обновляет кеш кампаний")
Rel(financialService, balanceCache, "Обновляет кеш балансов")

' ===== Запись в Kafka =====
Rel(deliveryService, clickTopic, "Пишет клики/показы")
Rel(campaignService, campaignTopic, "Пишет изменения кампаний")
Rel(paymentService, paymentTopic, "Пишет платежи")
Rel(financialService, balanceTopic, "Пишет изменения баланса")
Rel(adCabinet, reqReportTopic, "Заказывает отчёт")
Rel(adCabinet, respReportTopic, "Читает готовность отчёта")

' ===== Чтение из Kafka =====
Rel(statsService, clickTopic, "Читает клики/показы")
Rel(financialService, clickTopic, "Читает клики для списаний")
Rel(financialService, paymentTopic, "Читает платежи")
Rel(analyticsService, reqReportTopic, "Читает заказы отчётов")
Rel(analyticsService, respReportTopic, "Пишет готовность отчёта")

' ===== Работа с БД =====
Rel(campaignService, campaignDb, "Хранит кампании")
Rel(financialService, financeDb, "Хранит финансы")
Rel(statsService, eventsDb, "Пишет события")
Rel(analyticsService, eventsDb, "Читает события для отчётов")

' ===== Аннотации =====
note right of campaignService
  CRUD (создание, чтение,
  редактирование, удаление)
  кампаний, бюджетов и ставок.
  Владелец данных кампаний,
  публикует изменения в кеш и Kafka.
end note

note right of biddingService
  Hot path: ходит только в Redis,
  в БД не обращается
end note

legend right
  **Цели:** 50 000 RPS, P95 ≤ 80 мс, SLA 99.9%
  Hot path: B2B → Bidding → Redis → Delivery
  Async: события и отчёты через Kafka
endlegend

@enduml